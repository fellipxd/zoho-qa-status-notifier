# Zoho OAuth credentials from https://api-console.zoho.com/
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_PROJECTS_BASE_URL=https://projectsapi.zoho.com/api/v3
ZOHO_CLIENT_ID=replace_with_client_id
ZOHO_CLIENT_SECRET=replace_with_client_secret
ZOHO_REFRESH_TOKEN=replace_with_refresh_token

# Monitor every accessible project under one portal
ZOHO_PORTAL_ID=replace_with_portal_id
MONITOR_ALL_PROJECTS=true

# Alternative: monitor every accessible project under multiple portals
# ZOHO_PORTAL_IDS=replace_with_portal_id_1,replace_with_portal_id_2

# Alternative: monitor selected projects under one portal
# ZOHO_PROJECT_IDS=replace_with_project_id_1,replace_with_project_id_2
# ZOHO_PROJECT_NAMES=Board One,Board Two

# Alternative: monitor selected projects across multiple portals
# ZOHO_PROJECTS=[{"name":"Board One","portalId":"replace_with_portal_id","projectId":"replace_with_project_id_1"},{"name":"Board Two","portalId":"replace_with_portal_id","projectId":"replace_with_project_id_2"}]

# Board/status watch config
TARGET_STATUS_NAMES=QA,UAT,Ready for Release
POLL_INTERVAL_MINUTES=5

# Zoho Cliq target
CLIQ_WEBHOOK_URL=https://cliq.zoho.com/api/v2/channelsbyname/your-channel/message?zapikey=your_token

# Duplicate notification state file
NOTIFIED_STATE_FILE=./data/notified.json

# Optional: Set to true for verbose task logging while testing
DEBUG_TASKS=false
